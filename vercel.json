{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{refdoc/**,tests/**,database/**,public/assets/video/**}"
    }
  },
  "routes": [
    { "src": "/", "status": 308, "headers": { "Location": "/arabia/" } },
    { "src": "/arabia/assets/(.*)", "dest": "/assets/$1", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
